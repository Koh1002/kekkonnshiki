# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used by /screen to render the join QR code
# e.g. https://kekkonnshiki.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin authentication. Set any strong password; a single shared admin account.
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=generate-a-long-random-string
