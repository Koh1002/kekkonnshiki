# Firebase (Firebase Console → プロジェクト設定 → 全般)
# Web アプリ用の公開設定（NEXT_PUBLIC_ で埋め込み可）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxx

# サービスアカウント JSON を1行化して貼り付け（サーバー専用・絶対に公開しない）
# Firebase Console → プロジェクト設定 → サービスアカウント → 新しい秘密鍵を生成 で得た JSON
# 例: {"type":"service_account","project_id":"...","private_key":"...",...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public base URL used by /screen to render the join QR code
# e.g. https://kekkonnshiki.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 管理者（新郎新婦・司会）用アカウント名。これで /join すると /admin へ誘導。
# 第三者にたまたま当たらないよう十分に長くランダムな文字列にすること。
ADMIN_ACCOUNT_NAME=master-of-ceremony-xxxxxx

# スクリーン（会場プロジェクタ）用アカウント名。これで /join すると /screen へ誘導。
SCREEN_ACCOUNT_NAME=royal-screen-xxxxxx

# Admin authentication. Set any strong password; a single shared admin account.
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=generate-a-long-random-string
